  <!-- zippy=<start address of the "zippy_bb_0" block>, For spoof address, see TOOLS-7135 -->
  <rfchips zippy="50600000" spoof_base_address="88000000">
    <!--
      Override, if required, the default offsets of zippy registers relative to the start address above.

      Currently, the register offsets that can be overridden are listed below along
      with the values that moredump will use by default if they are not overridden
      (values are always expressed as non-prefixed hexadecimals):
        addressControlRegOffset: defaults to 0 (ZIPPY_BB_ADDR_CTRL)
        readDataRegOffset: 4                   (ZIPPY_BB_READ_DATA_MPORT_I0)
        interruptEnableRegOffset: 34           (ZIPPY_BB_INT_EN_I0)
        interruptStatusRegOffset: 38           (ZIPPY_BB_INT_STATUS)
        interruptClearRegOffset: 3c            (ZIPPY_BB_INT_CLEAR_I0)
        apbStatusRegOffset: 40                 (ZIPPY_BB_APB_STATUS_I0)
    -->
    <zippy
      addressControlRegOffset="40000"
      readDataRegOffset="4000c"
      interruptEnableRegOffset="44"
      interruptStatusRegOffset="48"
      interruptClearRegOffset="4c"
      apbStatusRegOffset="50"
      writeDataRegOffset="40004"
      writeDataMaskRegOffset="40008"
    />
    <rfchip name="bow" idat="0000" chipid="B7" interface="zippy">
      <extended_addressing rf_address="00001024:01" bb_address="5060002c:100000" />
      <version majorminor="00" xml="btwl/btwl/moredump/btwl_registers.xml" comment="S640 EVT0"/>
      <version majorminor="10" xml="btwl/btwl/moredump/btwl_registers.xml" comment="S640 EVT1.0"/>
      <exclude block="bracken_mem_0">
        <condition type="or">
          <test name="RFIC_BRACKEN_RAM_POWER_CTRL[0]" addr="00000064:111" value="7" comment="Off"/>
          <test name="RFIC_BRACKEN_RAM_POWER_CTRL[0]" addr="00000064:101" value="4" comment="Retention mode"/>
          <subcondition type="and" comment="">
            <test name="RFIC_CLKGEN_CONFIG_BT"    addr="00000084:100" value="0" comment=""/>
            <test name="RFIC_CLKGEN_CONFIG_WL[0]" addr="00000088:100" value="0" comment=""/>
            <test name="RFIC_CLKGEN_CONFIG_WL[1]" addr="0000008c:100" value="0" comment=""/>
          </subcondition>
        </condition>
      </exclude>
      <exclude block="bracken_mem_1">
